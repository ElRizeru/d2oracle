# STRATZ GraphQL API token (https://stratz.com/api)
STRATZ_TOKEN=your_stratz_jwt_token_here

# Hugging Face Hub token with write access to the dataset repo
HF_TOKEN=hf_your_huggingface_token_here
HF_REPO_ID=rizeru/d2oracle-data

# Target Dota 2 game version: "auto" (latest by asOfDateTime) or numeric STRATZ gameVersionId
TARGET_GAME_VERSION=auto

# Collector batch & storage settings
BATCH_SIZE=5000
SQLITE_PATH=data/d2oracle.sqlite3
PARQUET_DIR=data/shards
CONSTANTS_CACHE_DIR=data/constants

# Patch check & periodic seed discovery cadence (seconds)
PATCH_CHECK_INTERVAL_SECONDS=3600
PRO_DISCOVERY_INTERVAL_SECONDS=1800
PUBLIC_DISCOVERY_INTERVAL_SECONDS=1800

# Safe rate-limiter ceilings (below hard API limits)
STRATZ_RPS_LIMIT=6
STRATZ_RPM_LIMIT=130
STRATZ_RPH_LIMIT=1350
STRATZ_RPD_LIMIT=14000
OPENDOTA_RPM_LIMIT=50
OPENDOTA_RPD_LIMIT=2800

LOG_LEVEL=INFO
